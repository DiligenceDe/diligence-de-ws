{
	"name": "pl_silver",
	"properties": {
		"activities": [
			{
				"name": "LKP_Get_Silver_Objects",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    oc.object_id,\n    oc.source_schema,\n    oc.source_table,\n    oc.target_table,\n    oc.primary_key_columns,\n    oc.load_type,\n    oc.watermark_column,\n    oc.execution_order\nFROM metadata.object_config oc\nWHERE oc.source_id = @{pipeline().parameters.p_source_id}\n  AND oc.is_active = 1\n  AND oc.bronze_enabled = 1\n  AND oc.silver_enabled = 1\nORDER BY oc.execution_order;",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_db",
						"type": "DatasetReference",
						"parameters": {
							"table_schema": "metadata",
							"table_name": "object_config"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LKP_Get_Silver_Objects",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_Get_Silver_Objects').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "IF_Silver_Enabled",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"ifTrueActivities": [
									{
										"name": "SQL_Start_Silver_Log",
										"type": "Script",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "ls_sql_db",
											"type": "LinkedServiceReference"
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": {
														"value": "INSERT INTO metadata.table_run_log\n(\n    batch_id,\n    object_id,\n    layer_name,\n    attempt_number,\n    run_status,\n    start_time,\n    created_date,\n    modified_date\n)\nVALUES\n(\n    CAST('@{variables('v_batch_id')}' AS BIGINT),\n    @{item().object_id},\n    'SILVER',\n    1,\n    'RUNNING',\n    SYSUTCDATETIME(),\n    SYSUTCDATETIME(),\n    SYSUTCDATETIME()\n);",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									},
									{
										"name": "NB_Silver_Generic",
										"type": "DatabricksNotebook",
										"dependsOn": [
											{
												"activity": "SQL_Start_Silver_Log",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"notebookPath": {
												"value": "/Shared/AdventureWorks/NB_Silver_Generic",
												"type": "Expression"
											},
											"baseParameters": {
												"p_batch_id": "@variables('v_batch_id')",
												"p_object_id": "@string(item().object_id)",
												"p_source_schema": "@item().source_schema",
												"p_source_table": "@item().source_table",
												"p_target_table": "@item().target_table",
												"p_primary_key_columns": "@item().primary_key_columns",
												"p_load_type": "@item().load_type"
											}
										},
										"linkedServiceName": {
											"referenceName": "databricks",
											"type": "LinkedServiceReference"
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}