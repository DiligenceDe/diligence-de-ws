{
	"name": "pl_gold",
	"properties": {
		"activities": [
			{
				"name": "IF_Silver_Success",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('v_silver_status'), 'SUCCESS')",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "SQL_Start_Gold_Log",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "INSERT INTO metadata.table_run_log\n(\n    batch_id,\n    object_id,\n    layer_name,\n    attempt_number,\n    run_status,\n    start_time,\n    created_date,\n    modified_date\n)\nVALUES\n(\n    CAST('@{variables('v_batch_id')}' AS BIGINT),\n    @{item().object_id},\n    'GOLD',\n    1,\n    'RUNNING',\n    SYSUTCDATETIME(),\n    SYSUTCDATETIME(),\n    SYSUTCDATETIME()\n);",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "ds_sql_db",
									"type": "DatasetReference",
									"parameters": {
										"table_schema": "metadata",
										"table_name": "object_config"
									}
								},
								"firstRowOnly": false
							}
						},
						{
							"name": "NB_Gold_AdventureWorks",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "SQL_Start_Gold_Log",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Shared/AdventureWorks/NB_Gold_AdventureWorks"
							},
							"linkedServiceName": {
								"referenceName": "databricks",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"variables": {
			"v_silver": {
				"type": "String"
			}
		},
		"annotations": []
	}
}