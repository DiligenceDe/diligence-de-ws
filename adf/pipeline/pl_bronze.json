{
	"name": "pl_bronze",
	"properties": {
		"activities": [
			{
				"name": "LKP_Get_Bronze_Objects",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "WITH LatestLanding AS\n(\n    SELECT\n        batch_id,\n        object_id,\n        run_status,\n        ROW_NUMBER() OVER\n        (\n            PARTITION BY batch_id, object_id\n            ORDER BY attempt_number DESC\n        ) AS rn\n    FROM metadata.table_run_log\n    WHERE batch_id = CAST('@{pipeline().parameters.p_batch_id}' AS BIGINT)\n      AND layer_name = 'LANDING'\n),\nLatestSilver AS\n(\n    SELECT\n        batch_id,\n        object_id,\n        run_status,\n        ROW_NUMBER() OVER\n        (\n            PARTITION BY batch_id, object_id\n            ORDER BY attempt_number DESC\n        ) AS rn\n    FROM metadata.table_run_log\n    WHERE batch_id = CAST('@{pipeline().parameters.p_batch_id}' AS BIGINT)\n      AND layer_name = 'BRONZE'\n)\nSELECT\n    oc.object_id,\n    oc.source_schema,\n    oc.source_table,\n    oc.target_table,\n    oc.execution_order\nFROM metadata.object_config oc\nINNER JOIN LatestLanding b\n    ON oc.object_id = b.object_id\n   AND b.rn = 1\n   AND b.run_status = 'SUCCESS'\nLEFT JOIN LatestSilver s\n    ON oc.object_id = s.object_id\n   AND s.rn = 1\nWHERE oc.is_active = 1\n  AND oc.silver_enabled = 1\n  AND s.object_id IS NULL\nORDER BY oc.execution_order;",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_db",
						"type": "DatasetReference",
						"parameters": {
							"table_schema": "metadata",
							"table_name": "object_config"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LKP_Get_Bronze_Objects",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_Get_Bronze_Objects').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "IF_Bronze_Enabled",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"ifTrueActivities": [
									{
										"name": "SQL_Start_Bronze_Log",
										"type": "Script",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "ls_sql_db",
											"type": "LinkedServiceReference"
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": {
														"value": "INSERT INTO metadata.table_run_log\n(\n    batch_id,\n    object_id,\n    layer_name,\n    attempt_number,\n    run_status,\n    start_time,\n    created_date,\n    modified_date\n)\nVALUES\n(\n    CAST('@{variables('v_batch_id')}' AS BIGINT),\n    @{item().object_id},\n    'BRONZE',\n    1,\n    'RUNNING',\n    SYSUTCDATETIME(),\n    SYSUTCDATETIME(),\n    SYSUTCDATETIME()\n);",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									},
									{
										"name": "NB_Bronze_Generic",
										"type": "DatabricksNotebook",
										"dependsOn": [
											{
												"activity": "SQL_Start_Bronze_Log",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"notebookPath": {
												"value": "/Shared/AdventureWorks/NB_Bronze_Generic",
												"type": "Expression"
											},
											"baseParameters": {
												"p_batch_id": "@variables('v_batch_id')",
												"p_object_id": "@string(item().object_id)",
												"p_source_schema": "@item().source_schema",
												"p_source_table": "@item().source_table",
												"p_target_table": "@item().target_table",
												"p_primary_key_columns": "@item().primary_key_columns",
												"p_load_type": "@item().load_type",
												"p_bronze_path": {
													"value": "@concat(\n    'abfss://<container>@<storage-account>.dfs.core.windows.net/bronze/',\n    item().source_schema,\n    '/',\n    item().target_table,\n    '/batch_id=',\n    variables('v_batch_id')\n)",
													"type": "Expression"
												},
												"p_silver_path": {
													"value": "@concat(\n    'abfss://<container>@<storage-account>.dfs.core.windows.net/silver/',\n    item().source_schema,\n    '/',\n    item().target_table\n)",
													"type": "Expression"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "databricks",
											"type": "LinkedServiceReference"
										}
									},
									{
										"name": "SQL_Bronze_Success",
										"type": "Lookup",
										"dependsOn": [
											{
												"activity": "NB_Bronze_Generic",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "UPDATE metadata.table_run_log\nSET\n    run_status = 'SUCCESS',\n    end_time = SYSUTCDATETIME(),\n    modified_date = SYSUTCDATETIME()\nWHERE batch_id = CAST('@{variables('v_batch_id')}' AS BIGINT)\n  AND object_id = @{item().object_id}\n  AND layer_name = 'BRONZE'\n  AND run_status = 'RUNNING';",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"dataset": {
												"referenceName": "ds_sql_db",
												"type": "DatasetReference",
												"parameters": {
													"table_schema": "metadata",
													"table_name": "object_config"
												}
											},
											"firstRowOnly": true
										}
									},
									{
										"name": "SQL_Bronze_Failure",
										"type": "Lookup",
										"dependsOn": [
											{
												"activity": "NB_Bronze_Generic",
												"dependencyConditions": [
													"Failed"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "UPDATE metadata.table_run_log\nSET\n    run_status = 'FAILED',\n    end_time = SYSUTCDATETIME(),\n    error_message = 'Bronze notebook execution failed',\n    modified_date = SYSUTCDATETIME()\nWHERE batch_id = CAST('@{variables('v_batch_id')}' AS BIGINT)\n  AND object_id = @{item().object_id}\n  AND layer_name = 'BRONZE'\n  AND run_status = 'RUNNING';",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"dataset": {
												"referenceName": "ds_sql_db",
												"type": "DatasetReference",
												"parameters": {
													"table_schema": "metadata",
													"table_name": "object_config"
												}
											},
											"firstRowOnly": false
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "LKP_Check_Bronze_Status",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "ForEach",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    CASE\n        WHEN EXISTS\n        (\n            SELECT 1\n            FROM metadata.table_run_log\n            WHERE batch_id = CAST('@{pipeline().parameters.p_batch_id}' AS BIGINT)\n              AND layer_name = 'BRONZE'\n              AND run_status = 'FAILED'\n        )\n        THEN 'FAILED'\n\n        WHEN EXISTS\n        (\n            SELECT 1\n            FROM metadata.table_run_log\n            WHERE batch_id = CAST('@{pipeline().parameters.p_batch_id}' AS BIGINT)\n              AND layer_name = 'BRONZE'\n              AND run_status = 'RUNNING'\n        )\n        THEN 'RUNNING'\n\n        ELSE 'SUCCESS'\n    END AS bronze_status;",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_db",
						"type": "DatasetReference",
						"parameters": {
							"table_schema": "metadata",
							"table_name": "object_config"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "v_bronze_status",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "LKP_Check_Bronze_Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_bronze",
					"value": {
						"value": "@activity('LKP_Check_Bronze_Status').output.firstRow.bronze_status",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"p_batch_id": {
				"type": "string"
			},
			"p_source_id": {
				"type": "string"
			},
			"p_run_mode": {
				"type": "string"
			}
		},
		"variables": {
			"v_bronze": {
				"type": "String"
			}
		},
		"annotations": []
	}
}